# Copy to backend/.env (gitignored) or export in your shell. Names only: never commit real values.

# CONTRACT_FIXTURE (mock ledger, synthetic fixtures) or LOCAL_DEMO (real local Anvil deployment).
BACKEND_MODE=CONTRACT_FIXTURE
# Shared demo session token checked on every /api/v1 route except /health (>= 16 characters).
BACKEND_DEMO_SESSION=
# Explicit frontend origins, comma-separated. Empty = no CORS (use the frontend dev proxy).
BACKEND_CORS_ORIGINS=

# Storage (defaults under backend/runtime/, which is gitignored).
BACKEND_DB_PATH=backend/runtime/backend.sqlite
BACKEND_ARTIFACT_STORE=backend/runtime/artifacts

# Chain adapter: mock (CONTRACT_FIXTURE only) or web3 (required for LOCAL_DEMO).
BACKEND_CHAIN_ADAPTER=mock
BACKEND_MOCK_CHAIN_PATH=backend/runtime/mock-chain.sqlite
BACKEND_RPC_URL=http://127.0.0.1:8545
BACKEND_DEPLOYMENT_PATH=runtime/deployment.json
# Local Anvil dev keys for the signing roles (web3 adapter). Public test keys only; never real assets.
BACKEND_PRIVATE_KEY_ISSUER=
BACKEND_PRIVATE_KEY_ORACLE=
BACKEND_PRIVATE_KEY_BUYER=
BACKEND_PRIVATE_KEY_RECIPIENT=

# RS: cached_bundle imports the scenario bundle from config/scenarios.json (CACHED_REPLAY);
# rs_cli runs `python -m rs.verify --request ... --output ...` per job (COMPUTED).
BACKEND_RS_MODE=cached_bundle
BACKEND_RS_COMMAND=

BACKEND_WORKER_POLL_SECONDS=1.0

# Carbon Lens /api/v2. Its runtime files live beside the P0 ones and never inside them.
BACKEND_LENS_ENABLED=1
BACKEND_LENS_ARTIFACT_STORE=backend/runtime/lens-artifacts
BACKEND_LENS_WORK_DIR=backend/runtime/lens-runs

# REAL: rs.case2 and carbon answer, or nothing does. A missing engine is a failure and
# never a reason to substitute a vector. FIXTURE replays labelled vectors for tests and
# for the worked example of the statement; every result it produces is stamped
# STUB_FIXTURE and carries a fixture label the UI has to show. BACKEND_MODE=LOCAL_DEMO
# refuses FIXTURE outright.
BACKEND_LENS_ENGINE_MODE=REAL
# 1 makes a missing engine refuse the process rather than serve /api/v1 without the Lens.
BACKEND_LENS_REQUIRE_REAL=0
