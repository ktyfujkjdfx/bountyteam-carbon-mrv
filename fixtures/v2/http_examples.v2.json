  "createAnalysis": {
    "request": {
      "method": "POST",
      "path": "/api/v2/analyses",
      "headers": {
        "X-Demo-Session": "<session>",
        "Idempotency-Key": "lens-tver-2019-2024-0001",
        "Content-Type": "application/json"
      },
      "body": {
        "aoi_id": "RU_TVER_01",
        "year_start": 2019,
        "year_end": 2024,
        "claimed_units": null,
        "claim_origin": null,
        "include_optical": true
      }
    },
    "response": {
      "status": 202,
      "body": {
        "analysis_id": "00000000-0000-4000-8000-000000000001",
        "job_state": "QUEUED",
        "status_url": "/api/v2/analyses/00000000-0000-4000-8000-000000000001",
        "created_at": "2026-09-18T12:00:00Z"
      }
    }
  },
  "createAnalysis_idempotency_conflict": {
    "request": {
      "method": "POST",
      "path": "/api/v2/analyses",
      "headers": {
        "Idempotency-Key": "lens-tver-2019-2024-0001"
      },
      "body": {
        "aoi_id": "RU_TVER_01",
        "year_start": 2020,
        "year_end": 2024
      }
    },
    "response": {
      "status": 409,
      "body": {
        "error": {
          "code": "IDEMPOTENCY_CONFLICT",
          "message": "Idempotency-Key was already used with a different request",
          "details": {}
        },
        "request_id": "00000000-0000-4000-8000-0000000000ff"
      }
    }
  },
  "createAnalysis_invalid_period": {
    "request": {
      "method": "POST",
      "path": "/api/v2/analyses",
      "body": {
        "aoi_id": "RU_TVER_01",
        "year_start": 2024,
        "year_end": 2019
      }
    },
    "response": {
      "status": 422,
      "body": {
        "error": {
          "code": "INVALID_PERIOD",
          "message": "year_end must be greater than year_start",
          "details": {
            "year_start": 2024,
            "year_end": 2019
          }
        },
        "request_id": "00000000-0000-4000-8000-0000000000fe"
      }
    }
  },
  "createAnalysis_area_too_large": {
    "request": {
      "method": "POST",
      "path": "/api/v2/analyses",
      "body": {
        "geometry": {
          "type": "Polygon",
          "coordinates": [
            [
              [
                32.0,
                56.0
              ],
              [
                33.0,
                56.0
