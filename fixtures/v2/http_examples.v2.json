          "type": "Polygon",
          "coordinates": [
            [
              [
                35.0,
                57.0
              ],
              [
                35.01,
                57.0
              ],
              [
                35.01,
                57.01
              ],
              [
                35.0,
                57.01
              ],
              [
                35.0,
                57.0
              ]
            ]
          ]
        },
        "errors": []
      }
    }
  },
