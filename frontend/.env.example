# Copy to .env.local (never commit). Names only; no real secrets.
# fixture = contract-compatible offline adapter over SYNTHETIC golden fixtures; http = Backend /api/v1.
VITE_API_MODE=fixture
# Must end with /api/v1. Use a relative /api/v1 when the SPA is served by Backend on the same origin.
VITE_API_BASE_URL=http://127.0.0.1:8000/api/v1
# Local demo session header value expected by Backend (X-Demo-Session). Not production auth.
VITE_DEMO_SESSION=
# Default demo_authorization_id offered in the issue form.
VITE_DEMO_AUTHORIZATION_ID=SYNTHETIC-AUTH-001
